### CHECK_COMMAND_VARIABLE_INCREMENTED
GET {{AUTOMATION_API_ENDPOINT}}/automation/variables?page=0&size=20
Accept: application/json
Authorization: Bearer {{token}}

> {%
  client.test("Command variable was incremented by the action", function () {
    client.assert(response.status === 200, "200 OK");
    var variable = response.body.content
      .filter(it => it.id === client.global.get("commandCounterId"))
      .at(-1);
    client.assert(variable !== undefined, "command counter present");
    client.assert(Number(variable.value) === 5, "value incremented to 5");
  });
%}

### CREATE_PANEL
< {%
  client.global.set("cardId", "card-" + new Date().getTime());
%}

POST {{AUTOMATION_API_ENDPOINT}}/panels/commands/create-panel
Accept: application/json
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "autotest panel",
  "cards": [
    {
      "id": "{{cardId}}",
      "ruleId": "{{ruleId}}",
      "title": "autotest card"
    }
  ]
}

> {%
  client.test("Create panel returns id", function () {
    client.assert(response.status === 201, "201 Created");
    client.assert(response.body.id !== undefined, "panel has id");
  });
  client.global.set("panelId", response.body.id);
%}

