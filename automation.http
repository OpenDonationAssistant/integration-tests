### UPDATE_WORD_BLACKLIST
POST {{AUTOMATION_API_ENDPOINT}}/word-blacklist/commands/update
Accept: application/json
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "words": ["autotest-badword", "spam"]
}

> {%
  client.test("Update word blacklist", function () {
    client.assert(response.status === 200, "200 OK");
    client.assert(Array.isArray(response.body.words), "response has words");
    client.assert(response.body.words.indexOf("autotest-badword") >= 0, "word saved");
  });
%}

