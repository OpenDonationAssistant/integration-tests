### CLEAR_AUTOMATION_STATE
# set-state with empty lists is the delete mechanism for automation rules and variables.
POST {{AUTOMATION_API_ENDPOINT}}/automation/commands/set-state
Accept: application/json
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rules": [],
  "variables": []
}

> {%
  client.test("Clear automation rules and variables", function () {
    client.assert(response.status === 200, "200 OK");
  });
%}

### CHECK_AUTOMATION_STATE_CLEARED
GET {{AUTOMATION_API_ENDPOINT}}/automation/
Accept: application/json
Authorization: Bearer {{token}}

> {%
  client.test("Automation rules and variables are deleted", function () {
    client.assert(response.status === 200, "200 OK");
    client.assert(response.body.rules.length === 0, "no rules left");
    client.assert(response.body.variables.length === 0, "no variables left");
  });
%}
