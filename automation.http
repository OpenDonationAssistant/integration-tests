### CHECK_DONATIONGOAL_ON_PAYMENTPAGE_IS_DELETED
GET {{CONFIG_API_ENDPOINT}}/config/paymentpage?ownerId=testuser HTTP/1.1
Accept: application/json

> {%
  client.test("Check DonationGoal on PaymentPage", function () {
    client.assert(
      response.body.value.goals === null,
      "Goal deleted from PaymentPage",
    );
  });
%}

### GET_AUTOMATION_STATE
GET {{AUTOMATION_API_ENDPOINT}}/automation/
Accept: application/json
Authorization: Bearer {{token}}

> {%
  client.test("Automation state contains created rules and variables", function () {
    client.assert(response.status === 200, "200 OK");
    var ruleIds = response.body.rules.map(it => it.id);
    var variableIds = response.body.variables.map(it => it.id);
    client.assert(ruleIds.indexOf(client.global.get("ruleId")) >= 0, "goal rule present");
    client.assert(ruleIds.indexOf(client.global.get("commandRuleId")) >= 0, "command rule present");
    client.assert(variableIds.indexOf(client.global.get("counterId")) >= 0, "counter variable present");
    client.assert(variableIds.indexOf(client.global.get("commandCounterId")) >= 0, "command counter variable present");
  });
%}

### GET_AUTOMATION_VARIABLES
GET {{AUTOMATION_API_ENDPOINT}}/automation/variables?page=0&size=20
Accept: application/json
Authorization: Bearer {{token}}

> {%
  client.test("List automation variables", function () {
    client.assert(response.status === 200, "200 OK");
    client.assert(Array.isArray(response.body.content), "page has content");
    var ids = response.body.content.map(it => it.id);
    client.assert(ids.indexOf(client.global.get("counterId")) >= 0, "counter variable listed");
    client.assert(ids.indexOf(client.global.get("commandCounterId")) >= 0, "command counter variable listed");
  });
%}

### GET_AUTOMATION_RULES
GET {{AUTOMATION_API_ENDPOINT}}/automation/rules?page=0&size=20
Accept: application/json
Authorization: Bearer {{token}}

> {%
  client.test("List automation rules", function () {
    client.assert(response.status === 200, "200 OK");
    client.assert(Array.isArray(response.body.content), "page has content");
    var ids = response.body.content.map(it => it.id);
    client.assert(ids.indexOf(client.global.get("ruleId")) >= 0, "goal rule listed");
    client.assert(ids.indexOf(client.global.get("commandRuleId")) >= 0, "command rule listed");
  });
%}

