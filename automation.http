### CHECK_RULE_DISABLED
GET {{AUTOMATION_API_ENDPOINT}}/automation/
Accept: application/json
Authorization: Bearer {{token}}

> {%
  client.test("Goal rule is disabled after toggle", function () {
    client.assert(response.status === 200, "200 OK");
    var rule = response.body.rules.filter(it => it.id === client.global.get("ruleId")).at(-1);
    client.assert(rule !== undefined, "goal rule present");
    client.assert(rule.enabled === false, "rule disabled");
  });
%}

