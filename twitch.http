    "cumulative_total": 10,
    "is_anonymous": false
  }
}

### SENDING SUBSCRIPTION MESSAGE EVENT
POST {{TWITCH_API_ENDPOINT}}/twitch/events HTTP/1.1
Content-Type: application/json
Twitch-Eventsub-Message-Type: notification

{
  "subscription": {
    "type": "channel.subscription.message",
    "condition": {
      "broadcaster_user_id": "161598700"
    }
  },
  "event": {
    "broadcaster_user_id": "161598700",
    "user_name": "testone",
    "tier": "1000",
    "message": {
      "text": "Love the stream!"
    },
    "total": 1,
    "cumulative_total": 12,
    "streak_months": 5
  }
}

### SENDING CHANNEL POINTS REDEMPTION EVENT
POST {{TWITCH_API_ENDPOINT}}/twitch/events HTTP/1.1
Content-Type: application/json
Twitch-Eventsub-Message-Type: notification

{
  "subscription": {
    "type": "channel.channel_points_custom_reward_redemption.add",
    "condition": {
      "broadcaster_user_id": "161598700"
    }
  },
  "event": {
    "broadcaster_user_id": "161598700",
    "user_name": "testone",
    "user_input": "Never Gonna Give You Up",
    "reward": {
      "id": "1f2a3b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b",
      "title": "Music",
      "cost": 100,
      "prompt": "Enter a song"
    }
  }
}

