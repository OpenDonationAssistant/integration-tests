### GET_READ_GUIDES
GET {{NEWS_API_ENDPOINT}}/guides/commands/get-read
Accept: application/json
Authorization: Bearer {{token}}

> {%
  client.test("Read guides contain marked guide", function () {
    client.assert(response.status === 200, "200 OK");
    client.assert(Array.isArray(response.body.ids), "guides has ids array");
    client.assert(
      response.body.ids.indexOf(client.global.get("guideId")) >= 0,
      "marked guide is present",
    );
  });
%}

