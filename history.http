### CREATE_REEL_WIDGET
POST {{WIDGET_API_ENDPOINT}}/widgets/commands/add
Accept: application/json
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "reel",
  "sortOrder": 0,
  "name": "Рулетка"
}

> {%
  client.test("Successfully created Reel widget", function () {
    client.assert(response.status === 200, "200 OK");
    client.assert(
      response.body.id !== undefined && response.body.id !== null,
      "widget has id",
    );
  });
  client.global.set("reelWidgetId", response.body.id);
%}

### SET_PRIZES
PATCH {{WIDGET_API_ENDPOINT}}/widgets/{{reelWidgetId}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "config": {
    "properties": [
      { "name": "requiredAmount", "value": 100 },
      {
        "name": "titleFont",
        "value": {
          "family": "Roboto",
          "size": 24,
          "color": {
            "gradient": false,
            "gradientType": 0,
            "repeating": false,
            "colors": [{ "color": "#684aff" }],
            "angle": 0
          },
          "outline": { "enabled": false, "width": 0, "color": "#000000" },
          "weight": false,
          "italic": false,
          "underline": false,
          "shadows": [],
          "animation": "none",
          "animationType": "entire",
          "animationSpeed": "slow"
        }
      },
      {
        "name": "widgetBorder",
        "value": {
          "isSame": null,
          "bottom": { "width": 1, "type": "solid", "color": "#000000" },
          "top": { "width": 1, "type": "solid", "color": "#000000" },
          "left": { "width": 1, "type": "solid", "color": "#000000" },
          "right": { "width": 1, "type": "solid", "color": "#000000" }
        }
      },
      {
        "name": "cardBorder",
        "value": {
          "isSame": null,
          "bottom": { "width": 1, "type": "solid", "color": "#000000" },
          "top": { "width": 1, "type": "solid", "color": "#000000" },
          "left": { "width": 1, "type": "solid", "color": "#000000" },
          "right": { "width": 1, "type": "solid", "color": "#000000" }
        }
      },
      {
        "name": "selectionColor",
        "value": {
          "gradient": false,
          "gradientType": 0,
          "repeating": false,
          "colors": [{ "color": "#FFFFFF" }],
          "angle": 0
        }
      },
      { "name": "reelWinningEffect", "value": { "id": "blink" } },
      { "name": "perView", "value": 5 },
      { "name": "speed", "value": 250 },
      { "name": "time", "value": 10 },
      { "name": "optionList", "value": ["Ничего", "Выигрыш", "123"] },
      { "name": "backgroundImage", "value": null }
    ]
  }
}

### CREATE_DONATON_WIDGET
