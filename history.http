### CHECK_DONATON_END_DATE
GET {{WIDGET_API_ENDPOINT}}/widgets/{{donatonWidgetId}}
Authorization: Bearer {{token}}

> {%
  client.test("Donaton has end date", function () {
    client.assert(response.status === 200, "200 OK");
    var config = response.body.config;
    client.assert(
      config !== undefined && config !== null,
      "widget has config"
    );
    var properties = config.properties;
    client.assert(
      properties !== undefined && properties !== null,
      "config has properties",
    );
    var timerEnd = properties.filter(prop => prop.name === "timer-end");
    client.assert(timerEnd.length === 1, "widget has 'timer-end' property");
    var timestamp = timerEnd[0].value?.timestamp;
    client.assert(
      timestamp === "2026-03-23T06:59:00.999Z",
      "donaton has end date",
    )
  });
%}



### CHECK_UPDATED_DONATIONGOAL
GET {{CONFIG_API_ENDPOINT}}/config/paymentpage?ownerId=testuser HTTP/1.1
Accept: application/json

> {%
  client.test("Check DonationGoal on PaymentPage", function () {
    let goals = response.body.value.goals;
    client.assert(goals !== null);
    if (goals !== null) {
      client.assert(goals.length === 1);
      client.assert(goals[0].requiredAmount !== null);
      client.assert(
        goals[0].requiredAmount.major === 300,
        "Required amount should be 300",
      );
      client.assert(goals[0].accumulatedAmount !== null);
      client.assert(
        goals[0].accumulatedAmount.major === 100,
        "Accumulated amount should be 100",
      );
      client.assert(goals[0].accumulatedAmount.currency === "RUB");
    }
  });
%}

### CHECK_OLD_ALERT_UPDATE
GET {{STOMP_API_ENDPOINT}}/subscriptions/testuseralerts/messages

> {%
  client.test("Check widget event update", function () {
    client.assert(response.status === 200, "200 OK");
    client.assert(response.body !== null, "Response is not null");
    client.assert(response.body.messages !== null && response.body.messages.length > 0, "Widget has received messages");
  });
%}

### CHECK_GOAL_EVENT_UPDATE
GET {{STOMP_API_ENDPOINT}}/subscriptions/testusergoal/messages

> {%
  client.test("Check widget event update", function () {
    client.assert(response.status === 200, "200 OK");
    client.assert(response.body !== null);
    client.assert(response.body.messages !== null && response.body.messages.length > 0);
    const message = response.body.messages.filter((message) => {
      return message.body.goalId === client.global.get("goalId");
    }).at(-1);
    client.assert(message !== null && message !== undefined, "Goal found");
    client.assert(message.body.accumulatedAmount !== null, "Goal has accumulated amount");
    client.assert(message.body.accumulatedAmount.major === 100, "Amount is updated");
  });
%}

