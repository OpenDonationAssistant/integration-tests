### SET_PRICE_AND_END_DATE
PATCH {{WIDGET_API_ENDPOINT}}/widgets/{{donatonWidgetId}} HTTP/1.1
Accept: application/json
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "config": {
    "properties": [
      {"name":"price","value":{"unit":"HOUR","price":10}},
      {"name":"timer-end","value":{"timestamp":"2026-03-22T20:59:00.999Z"}}
    ]
  }
}

> {%
  client.test("Price and end date has been set", function () {
    client.assert(response.status === 200, "200 OK");
  });
%}

